{
  "name": "hatch-ts-space-couple-fridge-phone",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json",
    "build": "bun run build:server && bun run build:client",
    "build:server": "cd server && bun build ./src/actions.ts --target=bun --outfile=./dist/actions.js",
    "build:client": "bun ./client/build.mjs",
    "test": "cd client && npx vitest run --passWithNoTests",
    "test:watch": "cd client && npx vitest --passWithNoTests"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.5",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/preferences": "^6.0.3",
    "@hatch/space-sdk": "file:/home/hatch/skills/spaces/ts-runtime/dist/space-sdk.tgz",
    "@netlify/blobs": "^10.7.11",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.44.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "web-push": "^3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3",
    "@capacitor/cli": "^6.2.0",
    "vitest": "^1.6.0",
    "jsdom": "^24.1.0"
  }
}
